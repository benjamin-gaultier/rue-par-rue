{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow run harvest.yml *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push origin HEAD:claude/*)",
      "Bash(git push origin --delete claude/agent-*)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run watch *)",
      "PowerShell(gh workflow run harvest.yml *)",
      "PowerShell(git push -u origin claude/*)",
      "PowerShell(git push origin claude/*)",
      "PowerShell(git push origin HEAD:claude/*)",
      "PowerShell(git push origin --delete claude/agent-*)"
