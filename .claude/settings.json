    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh secret *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push origin HEAD:main*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f *)",
      "PowerShell(gh pr merge * --admin*)",
      "PowerShell(gh secret *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo edit *)"
    ]
  }
}
